# Optional. Copy to .env and adjust. Never commit .env.
# Orbital data comes from CelesTrak, which needs no account or credentials.

# How often to re-download each constellation from CelesTrak (hours, minimum 2;
# CelesTrak only updates its data every 2 hours)
REFRESH_HOURS=4

# After an error response from CelesTrak, pause all downloads for this many hours
# (CelesTrak's usage policy asks clients to stop on errors)
PAUSE_HOURS=6

# Grafana admin password for the Docker setup
GRAFANA_ADMIN_PASSWORD=admin
